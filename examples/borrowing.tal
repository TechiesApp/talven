// Call-scoped references keep ownership with the caller.
struct Counter {
    value: i32
}

fn read(counter: &Counter) -> i32 {
    return counter.value;
}

fn add(counter: &mut Counter, amount: i32) -> i32 {
    counter.value = counter.value + amount;
    return counter.value;
}

fn step_twice(counter: &mut Counter) -> i32 {
    add(&mut counter, 1);
    return add(&mut counter, 1);
}

fn main() -> i32 {
    let mut counter = Counter { value: 40 };
    step_twice(&mut counter);
    if (read(&counter) == 42) {
        return 0;
    }
    return 1;
}
