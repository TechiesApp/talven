fn gcd(a: i32, b: i32) -> i32 {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

fn lcm(a: i32, b: i32) -> i32 {
    if (a == 0 || b == 0) {
        return 0;
    }
    return (a / gcd(a, b)) * b;
}

fn main() -> i32 {
    if (lcm(4, 6) != 12) {
        return 1;
    }
    return 0;
}
