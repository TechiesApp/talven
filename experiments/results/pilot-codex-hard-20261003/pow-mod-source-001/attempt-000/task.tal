fn pow_mod(base: i32, exp: i32, m: i32) -> i32 {
    if (exp == 0) {
        return 1 % m;
    }
    let half = pow_mod(base, exp / 2, m);
    let squared = (half * half) % m;
    if (exp % 2 == 1) {
        return (squared * (base % m)) % m;
    }
    return squared;
}

fn main() -> i32 {
    if (pow_mod(2, 10, 1000) != 24) {
        return 1;
    }
    return 0;
}
