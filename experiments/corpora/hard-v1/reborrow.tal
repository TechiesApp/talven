struct Counter {
    value: i32
}

fn read(c: &Counter) -> i32 {
    return c.value;
}

fn add(c: &mut Counter, delta: i32) -> i32 {
    c.value = c.value + delta;
    return c.value;
}

fn bump_n(c: &mut Counter, times: i32, delta: i32) -> i32 {
    return read(&c);
}

fn main() -> i32 {
    let mut counter = Counter { value: 5 };
    if (bump_n(&mut counter, 3, 2) != 11) {
        return 1;
    }
    return 0;
}
