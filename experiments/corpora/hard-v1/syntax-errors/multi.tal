struct Meter {
    level: i32
}

fn read(m: &Meter) -> i32 {
    return m.level;
}

fn raise(m: &mut Meter, amount: i32) -> i32 {
    m.level = m.level + amount;
    return m.level;
}

fn in_range(x: i32, low: i32, high: i32) -> bool {
    return low <= x <= high;
}

fn classify(x: i32) -> i32 {
    if (x < 0) {
        return -1;
    } else if (x == 0) {
        return 0;
    }
    return 1;
}

fn boost(m: &mut Meter, x: i32) -> i32 {
    let before = read(m);
    let step = classify(x) * 10;
    raise(m, step);
    return read(m) - before;
}

fn scaled(x: i32) -> i32 {
    let x = x * 2;
    let x = x + 3;
    return x;
}

fn sum3(a: i32, b: i32, c: i32) -> i32 {
    let mut total = a;
    total = total + b;
    total = total + c;
    return total;
}

fn settle(m: Meter) -> i32 {
    let kept = m;
    return m.level + kept.level;
}

fn main() -> i32 {
    let mut meter = Meter { level: 5 };
    if (boost(&mut meter, 3) != 10) {
        return 1;
    }
    return 0;
}
